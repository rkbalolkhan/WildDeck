# --- Telegram ---
# Required. Get it from @BotFather.
BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ_01234567
# polling | webhook
BOT_MODE=polling
# Required when BOT_MODE=webhook (public HTTPS URL, e.g. https://example.com/webhook)
BOT_WEBHOOK_URL=
BOT_WEBHOOK_SECRET=
# Local bind address for the webhook server
BOT_WEBHOOK_HOST=127.0.0.1
BOT_WEBHOOK_PORT=8080

# --- Database ---
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/wilddeck
# Optional test database URL for running native PostgreSQL integration tests
TEST_DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/wilddeck_test

# --- Redis (Optional) ---
# Optional; leave empty to run purely with PostgreSQL persistence
REDIS_URL=

# --- Application ---
LOG_LEVEL=INFO
# development | production | testing
ENVIRONMENT=development
